# RoomSplat — nginx site.
# Installed to /etc/nginx/sites-available/default by deploy/install-roomsplat.sh
#
# Public hostname now serves the RoomSplat FastAPI app (viewer + both WebSockets on
# one origin) instead of the static LichtFeld viewer. The LAN vhost (Shellos on
# 127.0.0.1:4173) and the deny-all catch-all are unchanged.

# --- public: https://sea.octo80.com (via the cloudflared tunnel) -------------
# Reverse-proxies to the RoomSplat server on 127.0.0.1:8000. Same origin means the
# viewer, /assets, /ws/ingest and /ws/viewer are all served here — no CORS anywhere.
# Start the app with:  /home/junius/git/room-splat/server/run-server.sh
server {
    listen 80;
    listen [::]:80;
    listen 443 ssl;
    listen [::]:443 ssl;

    ssl_certificate     /etc/ssl/certs/nginx-selfsigned.crt;
    ssl_certificate_key /etc/ssl/private/nginx-selfsigned.key;

    server_name sea.octo80.com;

    # Keyframe JPEGs stream over the ingest WebSocket, not HTTP bodies, but keep a
    # generous cap for any future large POSTs.
    client_max_body_size 256m;

    # WebSockets: /ws/ingest (phone -> server) and /ws/viewer (server -> browser).
    location /ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Versioned, immutable cell + point-cloud assets: cache aggressively.
    location /assets/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Viewer bundle and everything else.
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Pre-existing Ollama proxy — left open, as it was before.
    location /ollama/ {
        proxy_pass http://127.0.0.1:11434/;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header Origin "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}

# --- LAN + localhost: Shellos, no password prompt on the local network -------
server {
    listen 80;
    listen [::]:80;
    listen 443 ssl;
    listen [::]:443 ssl;

    ssl_certificate     /etc/ssl/certs/nginx-selfsigned.crt;
    ssl_certificate_key /etc/ssl/private/nginx-selfsigned.key;

    # localhost, this host's name, and any IP on the local subnets.
    server_name localhost inception inception.local
                ~^100\.91\.155\.\d+$ ~^192\.168\.\d+\.\d+$ ~^10\.\d+\.\d+\.\d+$
                ~^172\.(1[6-9]|2\d|3[01])\.\d+\.\d+$;

    client_max_body_size 64m;

    location / {
        allow 127.0.0.1;
        allow ::1;
        allow 100.91.155.128/27;   # this machine's subnet
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny  all;

        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /ollama/ {
        proxy_pass http://127.0.0.1:11434/;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header Origin "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}

# --- catch-all: unknown Host gets nothing -----------------------------------
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;

    ssl_certificate     /etc/ssl/certs/nginx-selfsigned.crt;
    ssl_certificate_key /etc/ssl/private/nginx-selfsigned.key;

    server_name _;

    return 403;
}
